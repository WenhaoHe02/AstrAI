{
  "model_type": "autoregressive_lm",
  "vocab_size": 100000,
  "hidden_size": 2048,
  "num_hidden_layers": 24,
  "rms_norm_eps": 1e-05,
  "residual_norm_backend": "liger",
  "intermediate_size": 1344,
  "tie_word_embeddings": true,
  "max_position_embeddings": 32768,
  "rope_theta": 10000.0,
  "attn_type": "gqa",
  "attention_backend": "transformer_engine",
  "fused_qkv": true,
  "num_attention_heads": 16,
  "num_key_value_heads": 4,
  "use_qk_norm": false,
  "use_gated_attention": false,
  "ffn_type": "moe",
  "swiglu_backend": "liger",
  "fused_mlp_gate_up": true,
  "n_routed_experts": 32,
  "n_shared_experts": 1,
  "n_activated_experts": 2,
  "expert_parallel_size": 1,
  "expert_dispatch_backend": "torch",
  "expert_gemm_backend": "transformer_engine",
  "deepep_expert_alignment": 1,
  "deepep_overlap_with_compute": false,
  "deepep_cpu_sync": true,
  "moe_shared_expert_overlap": true,
  "moe_route_scale_before_down": true,
  "router_score_dtype": "fp32",
  "topk_method": "greedy",
  "router_aux_loss_coef": 0.01,
  "router_z_loss_coef": 0.001
}
