# Ignore everything
*

# Allow directories to be traversed
!*/

# Allow specific file types and root files
!astrai/**/*.py
!scripts/**/*.py
!tests/**/*.py
!csrc/**/*.py

!csrc/**/*.cu
!csrc/**/*.h
!csrc/**/*.cuh

!scripts/**/*.sh

# Allow GitHub files
!/.github/**

# Allow root files
!/.gitattributes
!/.dockerignore
!/Dockerfile
!/docker-compose.yml
!/assets/**
!/recipes/**
!/CONTRIBUTING.md
!/LICENSE
!/pyproject.toml
!/README.md
!/ARGUS_OBJECTIVE.md
!/ARGUS_OBJECTIVE_7B_A1B.md
!/docs/ARGUS_MC_SOTA_HANDOFF.md
!/docs/OPERATOR_HANDOFF_7B_A1B.md
# Allow extension modules (only source .py)
!/astrai/extension/**/*.py

# Allow build files
!/setup.py
